DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
NOMINATIM_USER_AGENT=FuelRouteOptimizer/0.1 (contact: your-email@example.com)
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_TIMEOUT_SECONDS=5
NOMINATIM_MIN_INTERVAL_SECONDS=1
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_SECONDS=8
CENSUS_GEOCODER_BATCH_URL=https://geocoding.geo.census.gov/geocoder/locations/addressbatch
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current
CENSUS_GEOCODER_TIMEOUT_SECONDS=120
GEOCODING_CACHE_TTL=86400
GEOCODING_FAILURE_CACHE_TTL=300
ROUTING_CACHE_TTL=3600
CACHE_DEFAULT_TIMEOUT=300
FUEL_STATION_CSV_PATH=fuel-prices-for-be-assessment.csv
STATION_DATA_CACHE_TTL=3600
STATION_GEOCODING_CANDIDATE_LIMIT=8
ROUTE_CORRIDOR_WIDTH_MILES=15
MAX_STATION_DETOUR_MILES=30
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_FUEL_ECONOMY_MPG=10
